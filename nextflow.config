// Plant-virus QC + assembly pipeline.
manifest {
    name            = 'rna-viral-screen'
    author          = 'Andrew Budge <andrewcbudge@gmail.com>'
    description     = 'QC, rRNA depletion and RNA viral assembly for plant RNA-seq'
    mainScript      = 'main.nf'
    version         = '0.2.6'
    nextflowVersion = '>=23.10.0'
}

params {
    // Tab-separated samplesheet with header: sample, fastq_1, fastq_2
    input = null

    // Relative FASTQ paths in the samplesheet resolve against this root.
    data_dir = null

    // Database root. Relative paths resolve against --data_dir; absolute paths
    // work independently. Required layout: sortmerna/smr_v4.3_default_db.fasta
    // and sortmerna/index/. Validated screening database: genomad/genomad_db.
    db = null

    outdir = "${projectDir}/results"

    // fastp
    fastp_quality = 20        // -q / --qualified_quality_phred

    // SPAdes contig filtering (seqkit)
    contig_min_length = 200   // drop contigs shorter than this
    contig_min_cov    = 10    // drop contigs with lower mean depth

}

// per-process cpus/memory/time + retry policy, and per-process directives
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    // CHPC SLURM + apptainer. How the production run goes.
    slurm {
        includeConfig 'conf/slurm.config'
    }

    // Single machine through apptainer — local development against a subset of
    // reads before committing to the scheduler.
    local {
        process.executor       = 'local'
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        process.resourceLimits = [ memory: 14.GB, cpus: 4, time: 24.h ]
    }
}

// Run provenance. report.html is the thing to ask a lab member for when a run
// goes wrong — it carries exit codes, peak memory and runtime per task.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html"      }
