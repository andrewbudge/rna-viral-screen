// CHPC SLURM executor + apptainer runtime.
// Re-run `mychpc batch` and update account/partition/qos as allocations change.
process {
    executor       = 'slurm'
    queue          = 'notchpeak-guest'
    clusterOptions = '--account=owner-guest --partition=notchpeak-guest --qos=notchpeak-guest'

    // apptainer is module-provided here, so load it inside every job — a batch
    // shell does not necessarily have it on PATH. Also `module load apptainer`
    // before launching nextflow itself on the login node.
    beforeScript   = 'module load apptainer/1.4.0'
}

executor {
    queueSize       = 5         // max concurrent SLURM jobs
    submitRateLimit = '5/1min'  // stay polite to the scheduler
}

apptainer {
    enabled    = true
    autoMounts = true
    // Converted .sif images are cached here so every job reuses one copy
    // instead of re-pulling. Keep it off $HOME, which has a quota.
    cacheDir   = '/scratch/general/vast/abudge/plant_virus_pipeline_storage/apptainer_nf'
    // autoMounts binds staged inputs, but the reference db and prebuilt index
    // are reached through symlinks into scratch — bind the root explicitly.
    runOptions = '--bind /scratch/general/vast/abudge'
}
