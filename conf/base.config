// Per-process resource requests. Seeds come from measured runs on lonepeak
// (Laney18, 18.2 M pairs, ~1.3 GB/mate raw):
//
//   FASTP              2 m 02 s, 3.0 GB peak, 575% of 8 cpus
//   SORTMERNA          1 h 24 m, 4.5 GB peak, 389% of 8 cpus
//   MULTIQC                6 s,  0.1 GB peak  (1 sample -- scales with count)
//
// SortMeRNA scales roughly linearly in read count, so the 4 h request holds to
// about 2.5x this library's depth; past that it exits 143 and the retry ladder
// picks it up at 8 h. Record the runtime here, not just the memory, whenever
// these are re-measured -- sizing time off directory timestamps is how the
// 4 h figure nearly got talked down to 1 h.
process {
    // light default — nothing should silently inherit a big ask
    cpus   = 2
    memory = 8.GB
    time   = 1.h

    // 137/140 = OOM or SLURM kill, 143 = SIGTERM (timeout), 139 = segfault.
    // Retry those with more memory and more wall time; fail fast on anything
    // else, because a tool that exited 1 will exit 1 again.
    errorStrategy = { task.exitStatus in [137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: FASTP {
        cpus   = 8
        memory = { 6.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withName: SPADES {
        // Seeds, unmeasured yet: rnaviralSPAdes runs a full multi-k-mer SPAdes
        // pass, so it is the most memory-hungry process here. Record real
        // runtime/memory on the first real run and right-size these.
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = { 3.h  * task.attempt }
    }

    withName: FILTER {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = 1.h
    }

    withName: SORTMERNA {
        // 16, not the 8 the 389% average would argue for: that average is
        // dragged down by single-threaded index load and output writing, so
        // it is not evidence that the alignment phase would be happy with 4.
        cpus   = 16
        // Measured 4.5 GB peak and 1 h 24 m at 18.2 M pairs, but later runs
        // hit memory failures. Request 32 GB initially; retries scale to 64 GB.
        // 3e6d564 cut time to 2 h while raising cpus, but SortMeRNA was only
        // averaging 389% -- 16 cpus do not buy 2x wall time, so 2 h stopped
        // covering even 1.5x and the jobs exited 143 with no headroom left.
        memory = { 32.GB * task.attempt }
        time   = { 4.h  * task.attempt }

        // If SortMeRNA is ever bumped past 4.3.4, it needs AVX2 and this
        // process alone must leave lonepeak. That override goes here:
        //   clusterOptions = '--account=ogden --partition=notchpeak-shared-short --qos=notchpeak-shared-short'
    }

    // Left at 8 GB despite using 128 MB on one sample: MultiQC holds parsed
    // stats for every sample in memory at once, so this is the one process
    // whose footprint grows with the size of the run.
    withName: MULTIQC {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = 1.h
    }

    withName: GENOMAD {
        cpus   = 8
        memory = { 40.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: BOWTIE2 {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: SAMTOOLS_SORT {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: DIAMOND_RVDB {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withName: DIAMOND_UNIREF90 {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withName: EVIDENCE {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    withName: BLASTN_VIROID {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
